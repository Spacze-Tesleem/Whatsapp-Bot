# HTTP port for the storefront, admin panel and webhook
PORT=3000

# Admin panel password (change this!)
ADMIN_PASSWORD=change-me

# SQLite database file (created automatically)
DB_FILE=./data/shop.db

# --- WhatsApp Cloud API (Meta) ---
# Leave WHATSAPP_TOKEN empty to run in dry-run mode (replies are printed to the console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you also enter in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=change-me-verify
# App secret from Meta dashboard; enables X-Hub-Signature-256 validation of incoming webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Seed sample products on first run (true/false)
SEED_DEMO=true

# Set to true when behind a proxy/load balancer (Render, Railway, nginx)
TRUST_PROXY=false
